# Environment template only. Never commit real credentials.
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:8080

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ceylonswift?schema=public

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
COOKIE_NAME=ceylonswift_refresh
COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

OTP_PROVIDER=test
OTP_TEST_CODE=
OTP_SMS_API_KEY=
OTP_EMAIL_API_KEY=

LOG_LEVEL=debug
TRUST_PROXY=false
