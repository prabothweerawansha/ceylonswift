  id             String    @id @default(uuid()) @db.Uuid
  jobName        String    @db.VarChar(160)
  jobRunId       String?   @db.Uuid
  failureCode    String    @db.VarChar(100)
  failureMessage String    @db.VarChar(500)
  attempts       Int
  safeContext    Json?
  failedAt       DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt     DateTime? @db.Timestamptz(3)
  resolutionNote String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([jobName, failedAt])
  @@index([resolvedAt, failedAt])
}
