NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://ceylonswift:ceylonswift_dev@localhost:5432/ceylonswift_dev?schema=public
FRONTEND_ORIGINS=http://localhost:5500
JSON_BODY_LIMIT=1mb

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
REFRESH_COOKIE_NAME=ceylonswift_refresh
REFRESH_COOKIE_PATH=/api/v1/auth

ACCESS_TOKEN_PRIVATE_KEY=
ACCESS_TOKEN_PUBLIC_KEY=
ACCESS_TOKEN_ISSUER=ceylonswift-api
ACCESS_TOKEN_AUDIENCE=ceylonswift-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PASSWORD_PEPPER=
MFA_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_ALLOWED_REDIRECT_ORIGINS=http://localhost:5500

OTP_PROVIDER=disabled
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=CeylonSwift
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5500
TRUST_PROXY=false
AUTH_RATE_LIMIT_STORE=memory

# Explicit, development-only provisioning controls. Never commit real values.
PROVISION_CONFIRM=
PROVISION_EMAIL=
PROVISION_PASSWORD=
LOG_LEVEL=info
SERVICE_NAME=ceylonswift-api
SERVICE_VERSION=0.2.0.1-open-beta
REQUEST_TIMEOUT_MS=15000
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=120
METRICS_ENABLED=true
TRACING_ENABLED=true
BACKGROUND_JOBS_ENABLED=false
BACKGROUND_JOBS_INTERVAL_SECONDS=900
CLEANUP_BATCH_SIZE=250
JOB_MAX_RETRIES=3
RETENTION_LOGIN_ATTEMPTS_DAYS=90
RETENTION_CHALLENGES_DAYS=7
RETENTION_SESSIONS_DAYS=90
RETENTION_INVITATIONS_DAYS=90
RETENTION_IDEMPOTENCY_DAYS=7
RETENTION_AUDIT_DAYS=2555
PUBLIC_BASE_URL=http://localhost:4000
LEGACY_DEMO_MODE=false
PRODUCTION_TOOLS_ENABLED=false

POSTGRES_DB=ceylonswift_dev
POSTGRES_USER=ceylonswift
POSTGRES_PASSWORD=ceylonswift_dev
POSTGRES_PORT=5432
